SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key
# Solo lectura: sin service key, scripts/validate_ads.py cae a esta para su
# reporte (SELECT nada mas). Ningun otro script ni la app web la aceptan como
# respaldo — la BD revoca los privilegios de escritura de anon/authenticated,
# asi que degradar a esta clave para un write ya no es un respaldo funcional.
SUPABASE_ANON_KEY=tu-anon-key

# GovInfo (gratis: https://api.govinfo.gov/signup/). Sin esta clave los campos
# profundos FAA (compliance_time, AMOC, supersession) se auto-skipean en silencio.
GOVINFO_API_KEY=

# FAA DRS (drs.faa.gov/drs-api, "Request / Renew API Key"): cabecera x-api-key de la
# API data-pull de DRS (ADs finales ADFRAWD y de emergencia ADFREAD). Vence a los
# 12 meses y la FAA puede revocarla; se renueva en la misma pagina. Solo backend:
# nunca en el frontend ni en logs.
DRS_API_KEY=
# Interruptor de la sincronizacion DRS ("1" o "true" la enciende). Apagado por
# defecto: sin el, el cliente no se construye aunque haya key.
DRS_API_ENABLED=
# Contacto que identifica al cliente ante DRS en el User-Agent
# ("Hyvento-AD-Search/<version> (+mailto:<contacto>)"). Con el flag
# encendido, si falta o no tiene forma de email el cliente no se construye
# (mismo trato que una key faltante). Sin direccion real de ejemplo aqui.
DRS_CONTACT_EMAIL=

# LLM para enrich_ai.py (endpoint OpenAI-compatible)
LLM_ENDPOINT=http://localhost:11434/v1
LLM_MODEL=
LLM_API_KEY=

# Flask API (app.py)
# Secreto compartido con el proxy de Next.js (api/proxy) — requerido en todo
# deploy. Sin el, las rutas de datos contestan 503 (el guard falla cerrado).
# SUPABASE_SERVICE_KEY tambien es requerida en todo deploy por la misma razon:
# sin ella el rate limiter falla cerrado (503) en toda ruta de datos.
INTERNAL_PROXY_SECRET=
# Solo desarrollo local: 1 permite las rutas de datos sin secreto, y solo para
# requests de loopback y fuera de Vercel. Nunca en un deploy.
ALLOW_UNAUTHENTICATED_LOCAL=

# dashboard_server.py (monitor local; dispara enrich_ai con la service key)
# Sin token el dashboard rehusa arrancar fuera de localhost.
DASHBOARD_TOKEN=
    